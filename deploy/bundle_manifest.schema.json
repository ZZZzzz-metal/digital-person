{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B6 independent participant bundle",
  "type": "object",
  "required": ["version", "code_commit", "a_source_commit", "model_version", "config_path", "files"],
  "properties": {
    "version": {"const": 1},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "a_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model_version": {"type": "string", "minLength": 1},
    "config_path": {"const": "weights/inference_config.base.json"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["B", "A", "model", "config", "license", "schema"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "additionalProperties": true
}
