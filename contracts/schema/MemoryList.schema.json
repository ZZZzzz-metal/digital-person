{
  "$defs": {
    "MemoryItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "enum": [
            "preferred_name",
            "study_goal",
            "exam_subject",
            "response_preference",
            "hobby"
          ],
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "value",
        "updated_at"
      ],
      "title": "MemoryItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/MemoryItem"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "enabled",
    "items"
  ],
  "title": "MemoryList",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "B1 team contract; official snapshots remain separate. Examples are fictional protocol fixtures, not inference verification."
}
