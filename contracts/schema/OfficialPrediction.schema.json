{
  "$defs": {
    "OfficialProfile": {
      "additionalProperties": false,
      "properties": {
        "personality_traits": {
          "items": {
            "enum": [
              "extroverted",
              "introverted",
              "open",
              "conservative",
              "high_conscientiousness",
              "casual",
              "agreeable",
              "assertive",
              "emotionally_stable",
              "sensitive"
            ],
            "type": "string"
          },
          "title": "Personality Traits",
          "type": "array",
          "uniqueItems": true
        },
        "interests": {
          "items": {
            "enum": [
              "study_exam",
              "programming_technology",
              "reading_writing",
              "film_animation",
              "music",
              "games",
              "sports_fitness",
              "travel_outdoor",
              "pets",
              "social",
              "career_development",
              "art_design"
            ],
            "type": "string"
          },
          "title": "Interests",
          "type": "array",
          "uniqueItems": true
        },
        "style": {
          "items": {
            "enum": [
              "brief",
              "detailed",
              "colloquial",
              "formal",
              "direct",
              "indirect",
              "humorous",
              "rational",
              "high_emotional_expression",
              "low_emotional_expression",
              "emoji_user"
            ],
            "type": "string"
          },
          "title": "Style",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "personality_traits",
        "interests",
        "style"
      ],
      "title": "OfficialProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Successful generation only. B preserves input ID outside this DTO.",
  "properties": {
    "response_text": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Response Text",
      "type": "string"
    },
    "emotion_label": {
      "enum": [
        "joy",
        "gratitude",
        "relaxed",
        "care",
        "pride",
        "neutral",
        "surprise",
        "mixed",
        "sadness",
        "loneliness",
        "anxiety",
        "anger",
        "fear",
        "disgust",
        "shame",
        "helplessness"
      ],
      "title": "Emotion Label",
      "type": "string"
    },
    "user_profile": {
      "$ref": "#/$defs/OfficialProfile"
    },
    "memory_refs": {
      "items": {
        "pattern": "^mem_[0-9]{6}$",
        "type": "string"
      },
      "title": "Memory Refs",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "response_text",
    "emotion_label",
    "user_profile",
    "memory_refs"
  ],
  "title": "OfficialPrediction",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "B1 team contract; official snapshots remain separate. Examples are fictional protocol fixtures, not inference verification."
}
