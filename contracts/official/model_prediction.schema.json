{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "response_text",
    "emotion_label",
    "user_profile",
    "memory_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "response_text": {
      "type": "string",
      "minLength": 1
    },
    "emotion_label": {
      "enum": [
        "joy",
        "gratitude",
        "relaxed",
        "care",
        "pride",
        "neutral",
        "surprise",
        "mixed",
        "sadness",
        "loneliness",
        "anxiety",
        "anger",
        "fear",
        "disgust",
        "shame",
        "helplessness"
      ]
    },
    "user_profile": {
      "type": "object",
      "required": [
        "personality_traits",
        "interests",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "personality_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "extroverted",
              "introverted",
              "open",
              "conservative",
              "high_conscientiousness",
              "casual",
              "agreeable",
              "assertive",
              "emotionally_stable",
              "sensitive"
            ]
          }
        },
        "interests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "study_exam",
              "programming_technology",
              "reading_writing",
              "film_animation",
              "music",
              "games",
              "sports_fitness",
              "travel_outdoor",
              "pets",
              "social",
              "career_development",
              "art_design"
            ]
          }
        },
        "style": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "brief",
              "detailed",
              "colloquial",
              "formal",
              "direct",
              "indirect",
              "humorous",
              "rational",
              "high_emotional_expression",
              "low_emotional_expression",
              "emoji_user"
            ]
          }
        }
      }
    },
    "memory_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^mem_[0-9]{6}$"
      }
    }
  },
  "$comment": "团队生成约束：由官方 submission schema 移除 B 回填的 id，并排除失败空值；不是官方原文件。"
}
