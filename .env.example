# Reference only: set these in your shell; the app does not load .env files.
# stub is an explicitly labelled demo engine. real never falls back to stub.
B2_MODE=stub
B2_MODEL_CONFIG=weights/inference_config.json
B2_DB_PATH=.runtime/b2.sqlite3
# 0 for localhost HTTP; use 1 when serving through HTTPS.
B2_COOKIE_SECURE=0

# The command in README binds Uvicorn to 127.0.0.1:8000.
# Model weights and training dependencies will be supplied by A later.
